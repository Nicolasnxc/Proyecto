# COPIA ESTE ARCHIVO A .env Y AJUSTA LOS VALORES CON TUS CREDENCIALES REALES

# =====================================
# CONFIGURACIÓN DJANGO
# =====================================
# Clave secreta del proyecto (generar una nueva en producción)
SECRET_KEY=django-insecure-a0ryi1!mwx1gzpm!007v_1r189xdn0w&s=k!#40lf&2@x1-tlq

# Modo de depuración (False en producción)
DEBUG=True

# Hosts permitidos para el servidor
ALLOWED_HOSTS=localhost,127.0.0.1

# =====================================
# CONFIGURACIÓN BASE DE DATOS
# =====================================
# Por defecto usa SQLite (db.sqlite3). Descomentar para usar PostgreSQL:
# DATABASE_URL=postgres://user:password@localhost:5432/catalogo_musical

# =====================================
# CONFIGURACIÓN OAUTH 2.0
# =====================================
# Client ID de la aplicación registrada en Django Admin
# Obtener en: http://localhost:8000/admin/ → OAuth2 Provider > Applications
OAUTH2_CLIENT_ID=tu_client_id_aqui

# Client Secret de la aplicación registrada en Django Admin
OAUTH2_CLIENT_SECRET=tu_client_secret_aqui

# =====================================
# CONFIGURACIÓN CORS (Frontend)
# =====================================
# Para desarrollo: permitir todos los orígenes
CORS_ALLOW_ALL_ORIGINS=True

# Para producción: especificar dominios específicos (comentar la línea anterior)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tu-dominio.com
